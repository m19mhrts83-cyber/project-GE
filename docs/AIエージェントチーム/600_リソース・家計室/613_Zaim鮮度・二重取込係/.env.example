# この社員の実行に必要なキーだけ（値はローカルの .env に書く。Git に値を入れない）
# 追加・変更したら ~/git-repos/.env.jarvis_private にも必ず同期（マスター）

# Slack（異常時 #ops）
# SLACK_WEBHOOK_OPS=

# Jarvis 投影（自分用 DB）。値は jarvis_private 正本
# JARVIS_SUPABASE_URL=
# JARVIS_SUPABASE_SERVICE_ROLE_KEY=

# 停止・抑制（任意・0/1）
# JARVIS_ZAIM_BANK_SYNC_DISABLE=
# JARVIS_ZAIM_BANK_AUTO_UPDATE=
# JARVIS_ZAIM_BANK_TRY_OTP=
