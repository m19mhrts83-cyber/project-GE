# これは見本です。本物の値（APIキーなど）は、ここには書きません。
# 使うときは、同じフォルダに .env.local という名前の自分用ファイルを作り、そこに書きます（SETUP.md の手順2）。
# キーが無いうちは LLM_PROVIDER=mock にすると、ダミー出力で流れを試せます。
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_GENERATE=
LLM_MODEL_IMPROVE=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_GENERATE=
LLM_FALLBACK_MODEL_IMPROVE=
EVENT_PASSCODE=
