# Jarvis Dashboard (自分用・jarvis-dashboard Supabase)
# コピーして .env.local に。値は .env.jarvis_private の JARVIS_SUPABASE_* から。
# ANON には新形式 sb_publishable_… を入れる（Legacy anon JWT は disabled）。

NEXT_PUBLIC_SUPABASE_URL=https://idkdqneutpvkhxhpjtgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Auth コールバック（ローカル）
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# サーバー専用（送信・Gemini見直し・Cursor Cloud）。Vercel にも同名で入れる。チャットに貼らない。
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GMAIL_CREDENTIALS_B64=
# GMAIL_ESTATE_TOKEN_B64=
# CURSOR_API_KEY=   # Cloud Agent 見直し本線（https://cursor.com/dashboard/api）
# CURSOR_CLOUD_REPO_URL=  # 任意。空なら no-repo agent
# Cursor 失敗時は Mac launchd ワーカー（scripts/jarvis_triage_cursor_revise_worker.py）
