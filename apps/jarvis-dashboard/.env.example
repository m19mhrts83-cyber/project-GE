# Jarvis Dashboard (自分用・jarvis-dashboard Supabase)
# コピーして .env.local に。値は .env.jarvis_private の JARVIS_SUPABASE_* から。
# ANON には新形式 sb_publishable_… を入れる（Legacy anon JWT は disabled）。

NEXT_PUBLIC_SUPABASE_URL=https://idkdqneutpvkhxhpjtgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Auth コールバック（ローカル）
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# 別アプリ KURASHIFT（ナビ外部リンク。旧 NEXT_PUBLIC_TRADE_DESK_URL も可）
# NEXT_PUBLIC_KURASHIFT_URL=https://jarvis-trade-desk.vercel.app
# NEXT_PUBLIC_TRADE_DESK_URL=https://jarvis-trade-desk.vercel.app

# サーバー専用（送信・Gemini見直し・Cursor Cloud・聞く注入）。Vercel にも同名で入れる。チャットに貼らない。
# 従量課金の AI API キーは置かない（2026-11-13）。文章生成は Mac の定額AI（ai_jobs 経由）。
# GEMINI_FREE_API_KEY=  # 課金を無効にした Google プロジェクトの鍵。「聞く」の神大家資料検索（埋め込み）だけに使う
# GMAIL_CREDENTIALS_B64=
# GMAIL_ESTATE_TOKEN_B64=
# GMAIL_ADMIN_TOKEN_B64=  # general トリアージのスキップ／送信済みで Gmail 既読にする（推奨）
# GMAIL_M19M_TOKEN_B64=   # 任意（m19m 取込分）
# CURSOR_API_KEY=   # Cloud Agent 本線（https://cursor.com/dashboard/api）
# CURSOR_CLOUD_REPO_URL=  # 任意。空推奨。聞くはコード側で常に no-repo
# ASK_AUTO_ALLOW_GEMINI=0  # 1のときだけ「自動」が Mac の定額AI（旧 Gemini 経路）を使う
# ASK_AUTO_ALLOW_CLOUD=0   # 1のときだけ「自動」がCloud APIを1回まで利用
# ASK_COST_GEMINI=flat  # 旧 Gemini 経路は Mac 定額AIになったので flat
# ASK_COST_CLOUD=metered   # free|flat を先に、同じ区分なら軽い（Gemini）→重い（Cloud）の順（R4）
# NOTION_API_TOKEN=  # 戻し用（JARVIS_TASK_BACKEND=notion）
# TODOIST_API_TOKEN=  # タスク正本（正本は .env.jarvis_private）
# JARVIS_TASK_BACKEND=todoist

# --- Private Obsidian ChatGPT relay (server-only, Vercel Production) ---
# Keep save, read, Mac poll, and watchdog credentials separate.
# OBSIDIAN_REVIEW_SUBMIT_KEY=
# OBSIDIAN_REVIEW_POLL_KEY=
# OBSIDIAN_REVIEW_READ_KEY=
# OBSIDIAN_VAULT_POLL_KEY=
# OBSIDIAN_REVIEW_MONITOR_KEY=
# SLACK_WEBHOOK_AI_TEAM_OPS=  # existing private #ops Incoming Webhook

# --- 聞く：文脈注入（Cloud はディスクを直接見ない）---
# 運営 kamiooya-qa 読取専用（JARVIS_SUPABASE_* とは別プロジェクト）
# SUPABASE_URL=https://mwubzgefkkjjbingrmqu.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# OneDrive パートナー 5.やり取り.md（委任 Graph）
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_REFRESH_TOKEN=
# MS_GRAPH_AUTHORITY=consumers
# MS_GRAPH_DRIVE_ID=   # 任意
# admin Drive 200_NoteBookLM（Phase3・手動オン）
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# GDRIVE_NOTEBOOKLM_FOLDER_ID=
# Cursor 失敗時は Mac launchd ワーカー（revise / card ask）
