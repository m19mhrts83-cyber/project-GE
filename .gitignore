!.cursor/rules/jarvis-materials-ingest.mdc
!.cursor/rules/notion-mcp-reauth.mdc
.obsidian/
.vscode/

# --- ローカル設定 ---
*.local.yaml
config_nichinoken.yaml
config_bank.yaml

# --- line_unofficial_poc: フォークはクローンのみ（巨大・別リポジトリ） ---
line_unofficial_poc/chrline-patchv2/

