# =============================================
# project-GE 一本化用 .gitignore（215 / DX / 500 / 300 共通）
# =============================================

# 退避した旧 .git（コミットしない）
.git.bak.*/

# --- 認証・秘密情報 ---
.env
.env.*
!.env.example
!.env.home_address.example
!.env.jarvis_private.example
token.json
token*.json
*.expired
credentials.json
credentials_*.json
**/token.json
**/credentials.json
**/token.pickle
**/*.pem
**/03_outputs/ai_news_save/token_for_github_secret_b64.txt
**/03_outputs/ai_news_save/.github_token

# --- 環境・キャッシュ（.venv は 100MB 超で GitHub 拒否のため必須） ---
.venv/
.venv_*/
**/.venv/
**/.venv_*/
**/venv/
**/venv_gmail/
__pycache__/
node_modules/
*.pyc
*.log
.DS_Store
_tmp/

# Jarvis 月次状態（ローカルのみ）
.jarvis_state/etc_monthly.json
.jarvis_state/shuhen_auto_jobs/
.jarvis_state/night_triage/queue.json
.jarvis_state/night_triage/dashboard.html
.jarvis_state/night_triage/config.json
.jarvis_state/night_triage/_agent_login.sh
# Vポイント調査の生ダンプ（Gmail本文・スクショ等）。要約は vpoint_audit_result.json のみ追跡
.jarvis_state/vpoint_audit_*.json
.jarvis_state/vpoint_audit_*.html
.jarvis_state/vpoint_audit_*.png
.jarvis_state/vpoint_tsite_history_*.json
# 例外: 運用サマリー結果はコミット対象
!.jarvis_state/vpoint_audit_result.json

# --- Q&Aチャットボット／ProgramCode の実行成果物（容量大） ---
**/神・大家さん倶楽部情報Q&Aチャットボット/state/exports/
ProgramCode/outputs/

# --- エディタ・ツール ---
.cursor/projects/
# ルールは原則コミットしない（例外: 地図・経路用の非秘密ルールのみ）
.cursor/rules/*
!.cursor/rules/home-address-maps.mdc
!.cursor/rules/n1-notebooklm-mirror.mdc
!.cursor/rules/jarvis-supabase-free-one-project.mdc
