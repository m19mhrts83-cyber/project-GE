JARVIS_ETC_MONTHLY_DISABLE=

# --- Zaim（Web版予算反映）---
ZAIM_LOGIN_EMAIL=
ZAIM_PASSWORD=
# ZAIM_GOOGLE_EMAIL=

# --- 会社連絡先（任意）---
