# Notion Internal Integration（ダッシュボード看板連携）
# https://www.notion.so/my-integrations → 新規作成 → Secrets の token
# 対象DBを「接続」で共有すること。値はチャットに貼らない。
NOTION_API_TOKEN=

# === 給与振込・マイカーローン資金移動（Olive寄せ関連）===
CARD_MIG_SALARY_OLIVE="status:pending_company_form;changed:;note:Olive余り/大垣17万/名銀16.5万/労金7万"
CARD_MIG_CAR_LOAN_MUFG_FUNDING="status:pending_kitteini;changed:;note:Oliveきちんと振込→MUFG35000"

# --- 神大家 Q&A 登録承認メール通知（GAS MailApp）---
# 詳細: 215_kamiooya/.../運用手順_登録承認メール通知.md
NOTIFY_WEBHOOK_URL=
NOTIFY_SHARED_SECRET=
NOTIFY_ADMIN_TO=
NOTIFY_APP_URL=

# --- Phase11 意味検索（Supabase pgvector + Gemini embedding）---
GEMINI_API_KEY=
# Tavily Web 検索（ローカル MCP / Cloud My Secrets。ダッシュボード下調べ）
TAVILY_API_KEY=
# Quiet Edge: iOS Shortcuts → /api/quiet-edge/health/ingest（Vercel にも同名）
QUIET_EDGE_INGEST_SECRET=
# Quiet Edge Phase3: ★Journal 同期先（未設定なら config/dashboard_lanes.yaml の obsidian_journal）
# QUIET_EDGE_JOURNAL_DIR=
# JARVIS_LANES_OBSIDIAN_JOURNAL=
SEMANTIC_SEARCH_URL=https://YOUR_PROJECT.supabase.co/functions/v1/semantic-search
SEMANTIC_SEARCH_SHARED_SECRET=

# --- Chapro（チャプロ）MyPrompt ---
# Googleログイン用メール（「Googleでログイン」）
CHAPRO_EMAIL=
# メール＋パスワードログインを使う場合のみ
CHAPRO_PASSWORD=

# --- Raimo / Lime（企業AI研修ライモBiz・MyPrompt）---
# ログイン先: https://raimo.buzz/login → https://raimo.buzz/myprompt
# チャプロと同グループだがアカウントは別。メール＋パスワードが正本。
# 旧称: LIMO / Lime（スクリプト互換で LIMO_PORTAL_* も可）
RAIMO_PORTAL_EMAIL=
RAIMO_PORTAL_PASSWORD=
RAIMO_APP_EMAIL=
RAIMO_APP_PASSWORD=

# --- Google Maps（project-GE 管理会社検索 / shuhen-map 周辺MAP）---
# Console: https://console.cloud.google.com/apis/credentials
# 有効化: Maps JavaScript API / Places API / Geocoding API
# 制限例: http://localhost:* と https://m19mhrts83-cyber.github.io/project-GE/*
GOOGLE_MAPS_API_KEY=

# --- eLTAX（地方税ポータル・クレジット納付）---
ELTAX_USER_ID=
ELTAX_PIN=

# Jarvis Dashboard (Vercel)
JARVIS_DASHBOARD_URL=https://jarvis-dashboard-amber.vercel.app
# 朝オープン: 既定は毎日開く。軌道後に pending≥1 のみにするなら:
# JARVIS_MORNING_OPEN_REQUIRE_PENDING=1
# 朝オープン裏更新に CHRLINE／オプチャを含める（重い・既定オフ。1=有効）
# JARVIS_MORNING_WITH_LINE=1
# オプチャ・メイン鮮度: 全ルート【メイン】0 が続く日数（既定3）／常時監視 alive 判定の heartbeat 秒（既定300）
# JARVIS_OPENCHAT_MAIN_STALE_DAYS=3
# JARVIS_OPENCHAT_WATCH_ALIVE_HB_SEC=300
# 状況ウォッチ／オプチャ「確認した」後のバッジ静穏日数（既定7・指紋変化で即再表示）
# JARVIS_WATCH_ACK_QUIET_DAYS=7
VERCEL_TOKEN=

# GHA / Graph
GMAIL_ADMIN_TOKEN_PATH=
# --- Microsoft Graph / OneDrive（レーン GHA）---
# 個人用 OneDrive（推奨）: デバイスコード後の refresh
# 手順: docs/Jarvis_OneDrive_Graph.md
MS_GRAPH_CLIENT_ID=
MS_GRAPH_AUTHORITY=consumers
MS_GRAPH_REFRESH_TOKEN=
# 公開クライアントなら SECRET は空で可
MS_GRAPH_CLIENT_SECRET=
# 職場テナントのアプリ専用のみ（個人用では通常不要）
MS_GRAPH_TENANT_ID=
MS_GRAPH_USER_UPN=
MS_GRAPH_DRIVE_ID=

# Dashboard Gmail send (Vercel server env にも)
GMAIL_CREDENTIALS_B64=
GMAIL_ESTATE_TOKEN_B64=
GMAIL_M19M_TOKEN_B64=

# Cursor Cloud Agent（ダッシュボード見直し本線）
CURSOR_API_KEY=
CURSOR_CLOUD_REPO_URL=https://github.com/m19mhrts83-cyber/project-GE

