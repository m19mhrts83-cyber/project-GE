# Jarvis 用プライベート情報（住所・法人番号・個人情報の正本）
# -------------------------------------------------
# 使い方:
#   cp .env.jarvis_private.example .env.jarvis_private
#   エディタで .env.jarvis_private を開き、値を埋める
#
# .env.jarvis_private は .gitignore により Git / GitHub に含まれません。
# 旧 .env.home_address の自宅住所はここへ移す（HOME_ADDRESS）。
#
# 表記ルール（住所）:
#   - 番地・丁目など住所文字列内の数字 → 全角（例: ３４２番地２５）
#   - 郵便番号・電話・カード番号等 → 半角（Webフォームの専用欄用）

# --- 自宅（地図・経路・フォーム）---
HOME_POSTAL_CODE=
HOME_PREF=
HOME_ADDRESS=
HOME_ADDRESS_STREET=
HOME_ADDRESS_BANTI=
HOME_ADDRESS_KANA_STREET=
HOME_ADDRESS_KANA_BANTI=
# 住居（ローン申込）。居住年数は HOME_BUILT_YM（建築年月）から jarvis_car_loan_prefill.sh が自動計算
# HOME_OCCUPIED_SINCE=  # 入居年月が建築と異なるときだけ（未設定時は HOME_BUILT_YM を使用）
HOME_RESIDENCE_TYPE=自己所有
HOME_RESIDENCE_TYPE_CODE=1
HOME_STRUCTURE=一戸建て
HOME_BUILT_YM=
FAMILY_HOUSEHOLD_SIZE=
SPOUSE_HAS=
CHILDREN_COUNT=
# HOME_LAT=
# HOME_LON=

# --- 法人 ---
COMPANY_NAME=
COMPANY_NAME_KANA=
COMPANY_NAME_KANA_BANK=
CORPORATE_NUMBER=
# 適格請求書発行事業者番号（登録済みなら T+法人番号）
COMPANY_INVOICE_NUMBER=
COMPANY_POSTAL_CODE=
COMPANY_PREF=
COMPANY_ADDRESS=
COMPANY_ADDRESS_STREET=
COMPANY_ADDRESS_BANTI=
COMPANY_ADDRESS_KANA_STREET=
COMPANY_ADDRESS_KANA_BANTI=
# 登記上の代表。実務担当が別なら COMPANY_CONTACT_NAME
REPRESENTATIVE_NAME=
COMPANY_REPRESENTATIVE_TITLE=
COMPANY_CONTACT_NAME=
COMPANY_SHAREHOLDER_NAME=
COMPANY_SHAREHOLDER_RATIO=
COMPANY_FOUNDED=
COMPANY_FISCAL_YEAR_END=
COMPANY_FISCAL_MONTH=
COMPANY_PERIOD=
COMPANY_CAPITAL=
COMPANY_BUSINESS=
COMPANY_BUSINESS_DETAIL=
COMPANY_TAX_ACCOUNTANT=
COMPANY_BANK_RELATION_NAME=
COMPANY_BANK_RELATION_BRANCH=

# --- 本人（任意・フォーム入力用）---
PERSONAL_NAME=
PERSONAL_NAME_KANA_FAMILY=
PERSONAL_NAME_KANA_GIVEN=
# 神大家 WeStudy 会員番号（グルコン成果報告ヘッダ用）
KAMIOOYA_MEMBER_ID=
PERSONAL_BIRTHDATE=
PERSONAL_PHONE=
PERSONAL_EMAIL=

# --- ETC・マイレージ（フォーム入力・照会用）---
ETC_MILEAGE_ID=
ETC_CARD_NUMBER=
ETC_CARD_NUMBER_WEB=
ETC_CARD_EXPIRY=
ETC_ONBOARD_DEVICE_NUMBER=
ETC_VEHICLE_PLATE_LAST4=
ETC_MILEAGE_WEB_PASSWORD=
ETC_MILEAGE_VOICE_PASSWORD=

# --- ETC利用照会サービス（etc-meisai.jp）---
ETC_MEISAI_REGISTERED_AT=
ETC_MEISAI_STATEMENT_CHECK_RECORDED_AT=
ETC_MEISAI_STATEMENT_CHECK_AFTER_HOURS=4
