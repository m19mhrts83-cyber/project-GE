# Cloud Agent Environment Secrets（名前のみ・値は入れない）
# 実値は Cursor Dashboard → Cloud Agents → Environment → Secrets
# および ~/git-repos/.env.jarvis_private（ローカル正本）

JARVIS_SUPABASE_URL=
JARVIS_SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# 任意（admin Gmail を Cloud シェルから直接叩くとき）
GMAIL_CREDENTIALS_B64=
GMAIL_ADMIN_TOKEN_B64=
GMAIL_CREDENTIALS_PATH=
GMAIL_ADMIN_TOKEN_PATH=
