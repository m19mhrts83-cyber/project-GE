JARVIS_SUPABASE_URL=
JARVIS_SUPABASE_SERVICE_ROLE_KEY=
JARVIS_SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# Tavily Web 検索（ローカル MCP / Cloud 共有。正本は .env.jarvis_private）
TAVILY_API_KEY=
# ダッシュボード Cursor Agent 見直し（Cloud 本線）。Vercel にも同名
CURSOR_API_KEY=
# 任意。空なら project-GE。Ops Fail 自動修復の Cloud Agent 用
CURSOR_CLOUD_REPO_URL=
# 任意（admin Gmail を Cloud シェルから直接叩くとき）
GMAIL_CREDENTIALS_B64=
GMAIL_ADMIN_TOKEN_B64=
# Cloud からのパートナー返信送信（estate 推奨・m19m 可）
GMAIL_ESTATE_TOKEN_B64=
GMAIL_M19M_TOKEN_B64=
GMAIL_CREDENTIALS_PATH=
GMAIL_ADMIN_TOKEN_PATH=
GMAIL_SEND_TOKEN_PATH=
# OneDrive Graph（レーン GHA）
# 個人用: CLIENT_ID + REFRESH_TOKEN + AUTHORITY=consumers（推奨）
MS_GRAPH_CLIENT_ID=
MS_GRAPH_AUTHORITY=consumers
MS_GRAPH_REFRESH_TOKEN=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_USER_UPN=
MS_GRAPH_DRIVE_ID=
