# comm-hub-backup（launchd/comm_hub_backup_runner_op.sh）が 1Password から読む秘密の「場所」だけ。値は書かない。
# 書式: KEY=op://<保管庫ID>/<項目タイトル>/<フィールド>
# 保管庫 = 「エージェント」（Service Account jarvis-agents が読み取りだけできる）。1キー＝1項目、タイトル＝キー名。
# MS_GRAPH_REFRESH_TOKEN は実行のたびに回転して書き戻すので、ここには入れず .env.jarvis_private に残す。
JARVIS_SUPABASE_URL=op://umwcjvehjykpr3ibzwk5a6ueuq/JARVIS_SUPABASE_URL/password
JARVIS_SUPABASE_SERVICE_ROLE_KEY=op://umwcjvehjykpr3ibzwk5a6ueuq/JARVIS_SUPABASE_SERVICE_ROLE_KEY/password
SLACK_WEBHOOK_AI_TEAM_HUB=op://umwcjvehjykpr3ibzwk5a6ueuq/SLACK_WEBHOOK_AI_TEAM_HUB/password
SLACK_WEBHOOK_AI_TEAM_OPS=op://umwcjvehjykpr3ibzwk5a6ueuq/SLACK_WEBHOOK_AI_TEAM_OPS/password
